# Optional absolute API base URL for split-origin deployments.
# Leave empty when a reverse proxy serves the frontend and API together.
VITE_API_BASE_URL=

# Optional explicit WebSocket endpoint. Derived from API/page URL when empty.
VITE_WS_URL=

# Backend target used only by the Vite development proxy.
VITE_DEV_API_TARGET=http://localhost:8080
